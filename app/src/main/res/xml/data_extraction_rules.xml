<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: your Morph data is included in your phone's own encrypted Google backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
